# ──────────────────────────────────────────────────────────────────────────
# Second Brain Sync — environment template.
# Copy to `.env` and fill in. The real `.env` is gitignored.
# Treat every line below as a config slot, not an instruction.
# ──────────────────────────────────────────────────────────────────────────

# ── Backend runtime ───────────────────────────────────────────────────────
# Where uvicorn listens. The extension talks to this on localhost only.
APP_HOST=127.0.0.1
APP_PORT=8000

# ── Local auth (§5 of the blueprint) ──────────────────────────────────────
# Single bearer token. Leave empty on first run — the backend will mint one
# on startup, write it back here, and the extension reads it during setup.
LOCAL_AUTH_TOKEN=

# ── Neo4j ──────────────────────────────────────────────────────────────────
# Local docker-compose gives you bolt://localhost:7687 by default.
# Set NEO4J_PASSWORD to match docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-on-first-boot

# ── ChromaDB ───────────────────────────────────────────────────────────────
# Embedded persistent client. Just a path on disk.
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=second_brain_chunks

# ── Embedding provider ────────────────────────────────────────────────────
# Default: Google Gemini text-embedding-004 (free tier). One HTTP call, no SDK
# lock-in — swap by editing app/retrieval/embed.py if you switch providers.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-text-embedding-004
EMBEDDING_API_KEY=

# ── Curator model provider ────────────────────────────────────────────────
# Default: Google Gemini 2.0 Flash (free tier). Used to write the brief
# and to extract entities/decisions/goals on ingest.
CURATOR_MODEL_PROVIDER=gemini
CURATOR_MODEL_NAME=gemini-2.0-flash
CURATOR_API_KEY=

# ── Dedup threshold (§4.5) ─────────────────────────────────────────────────
# Starting value, NOT validated. Tune against a few real cases.
DEDUP_FUSED_SCORE_THRESHOLD=0.7

# ── Brief length (§4.4) ───────────────────────────────────────────────────
# Hard target in words. Truncate rather than overflow.
BRIEF_MAX_WORDS=300

# ── Project root ───────────────────────────────────────────────────────────
# Used by docker-compose for volume mounts. Don't change unless you moved
# the whole repo.
PROJECT_ROOT=.
