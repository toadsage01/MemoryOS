{
  "manifest_version": 3,
  "name": "Second Brain Sync",
  "version": "0.1.0",
  "description": "Personal memory layer for your LLM web chats. Brief me / Capture buttons for Claude, Gemini, and ChatGPT.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Second Brain Sync"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/adapters/claude.js",
        "content/adapters/gemini.js",
        "content/adapters/chatgpt.js",
        "content/shared/panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
